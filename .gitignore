# Local signing keys (updater minisign keypair; private key belongs in GH secrets)
secrets/

# Local agent reports and the generated HTML report (local-only, not source)
reports/
report.html
tools/build-report.mjs

# Build/test caches and scratch artifacts
*.tsbuildinfo
.eslintcache
.turbo/
.parcel-cache/
test-results/
playwright-report/
*.tmp
*.bak
*.orig
*.rej

# Screenshot pipeline output (generated; mandelbrot image is generated by FFmpeg in CI)
tests/screenshots/current/
tests/screenshots/diff/

# Local-only cargo config (kache rustc-wrapper)
src-tauri/.cargo/
